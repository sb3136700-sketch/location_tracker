# ========================================================================
# CAMPUSONE ENVIRONMENT CONFIGURATION
# ========================================================================

# GEMINI_API_KEY: Required for Gemini AI Campus Assistant and Smart Study Planner.
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE: Optional production database. When left empty, CampusOne runs
# in seamless high-fidelity Demo Mode with in-memory persistence and realistic data.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# GOOGLE MAPS API: Optional. CampusOne provides interactive OpenStreetMap/Leaflet
# with zero external API key requirements, as well as Google Maps embed support.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# HOSTING URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SMS INTEGRATION ADAPTER (Server-side only — never exposed to client)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""
